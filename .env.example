# Copy to .env and edit.  Anything already in the environment wins over this file.
# Nothing here is needed for the offline parts (local store, .csdb, examples).

# ---- the CSWeb server -------------------------------------------------------
# The "/api" suffix is optional - it is added if you leave it off.
CSWEB_URL=https://csweb.example.org/csweb/api
CSWEB_USER=
CSWEB_PASSWORD=

# Device id written into every vector clock you push.  Give each machine or
# process its own, the way each tablet has one: it is how CSPro works out
# whose version of a case is newer.
CSWEB_DEVICE=csync

# Set to 0 for a self-signed development server (leave 1 in production).
CSWEB_VERIFY_TLS=1

# Seconds per request.  Case pulls on a big dictionary can be slow.
CSWEB_TIMEOUT=300

# ---- local -----------------------------------------------------------------
# The working store: an ordinary SQLite file you can open with any client.
CSYNC_STORE=data/csync.db

# Folder searched for .dcf files before asking the server for one.
CSYNC_DICTS=dicts

# Cases per POST.  200 is a safe batch size for CSWeb.
CSYNC_BATCH=200

# ---- the optional web front end --------------------------------------------
CSYNC_WEB_HOST=127.0.0.1
CSYNC_WEB_PORT=8800
